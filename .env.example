APP_NAME=VisionScribe AI
APP_ENV=development
VISIONSCRIBE_DEBUG=false
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./visionscribe.db
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600
REQUEST_TIMEOUT_SECONDS=120
URL_DOWNLOAD_TIMEOUT_SECONDS=120
MAX_URL_REDIRECTS=3
UPLOAD_CHUNK_SIZE_BYTES=1048576
FFPROBE_BINARY=tools/ffmpeg/bin/ffprobe.exe
FFMPEG_BINARY=ffmpeg
LOG_LEVEL=INFO
TEMP_DIR=temp
FRAME_SAMPLE_INTERVAL_SECONDS=1.0
MAX_SAMPLED_FRAMES=600
FACE_DETECTION_THRESHOLD=0.50
FACE_DETECTION_SIZE=640
FACE_MODEL_NAME=buffalo_l
FACE_MODEL_ROOT=models
FACE_DEVICE=auto
TRANSCRIBE_WITHOUT_FACE=false
WHISPER_MODEL=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_CPU_COMPUTE_TYPE=int8
WHISPER_CUDA_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
WHISPER_MODEL_ROOT=models/whisper
WHISPER_DOWNLOAD_ROOT=models/whisper
WHISPER_LANGUAGE=
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_FORMAT=wav
AUDIO_EXTRACTION_TIMEOUT_SECONDS=300
